<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundleDisplayName</key>
        <string>OpenWords</string>
        <key>CFBundleLocalizations</key>
        <array>
            <string>en</string>
            <string>nl</string>
            <string>pl</string>
            <string>ru</string>
            <string>de</string>
            <string>es</string>
            <string>it</string>
            <string>fr</string>
            <string>cs</string>
            <string>tr</string>
            <string>zh-Hans</string>
        </array>
        <key>CADisableMinimumFrameDurationOnPhone</key>
        <true/>

        <!-- Expose the Documents directory (app-data exports live in Documents/OpenWords) in the Files app so an export
             can be re-imported on device. Databases live under Application Support and stay private. -->
        <key>UIFileSharingEnabled</key>
        <true/>
        <key>LSSupportsOpeningDocumentsInPlace</key>
        <true/>

        <key>NSAppTransportSecurity</key>
        <dict>
            <key>NSExceptionDomains</key>
            <dict>
                <key>storage.googleapis.com</key>
                <dict>
                    <key>NSExceptionAllowsInsecureHTTPLoads</key>
                    <true/>
                </dict>
            </dict>
        </dict>
    </dict>
</plist>
