<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cloud backup (Android 12+). Include application database and local cache databases;
         downloaded DB files are excluded by omission. -->
    <cloud-backup>
        <include domain="database" path="app.db"/>
        <include domain="database" path="local_dictionary.db"/>
        <include domain="database" path="local_translation.db"/>
    </cloud-backup>

    <!-- Device-to-device transfer (Android 12+). Mirror the same include policy. -->
    <device-transfer>
        <include domain="database" path="app.db"/>
        <include domain="database" path="local_dictionary.db"/>
        <include domain="database" path="local_translation.db"/>
    </device-transfer>
</data-extraction-rules>
