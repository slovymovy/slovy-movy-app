                ],
                "senses": [
                    {
                        "sense_id": "afaeb941-de6a-30ed-abf6-b97a3e656776",
                        "entry_id": "83203dde-c32a-3850-bd06-e6f09e5d8fcf",
                        "glosses": [
                            "lopen tot men ergens doorheen is"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "90fc28f5-ae76-4c71-b7bd-51836492e7fa",
                                "sense_id": "afaeb941-de6a-30ed-abf6-b97a3e656776",
                                "text": "Ik liep door de tunnel tot ik aan het andere einde was gekomen."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c6f51b6-b524-35cf-a56b-cca2de570d07",
                        "entry_id": "83203dde-c32a-3850-bd06-e6f09e5d8fcf",
                        "glosses": [
                            "voortgaan met lopen, in een wat hoger tempo dan normaal"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d9197a34-b8db-488b-864d-dcd044e3b84f",
                                "sense_id": "2c6f51b6-b524-35cf-a56b-cca2de570d07",
                                "text": "Wij moesten hard doorlopen om de trein te kunnen halen."
                            },
                            {
                                "example_id": "a472c4fc-1b54-4c96-a6b9-c030c42fd3b1",
                                "sense_id": "2c6f51b6-b524-35cf-a56b-cca2de570d07",
                                "text": "De rest van de nacht was Kleine Woord doorgelopen zonder zich ook maar een enkel ogenblik moe te voelen of zelfs te rusten."
                            },
                            {
                                "example_id": "a980ad3c-b692-4a9b-a540-3c685cc0e84a",
                                "sense_id": "2c6f51b6-b524-35cf-a56b-cca2de570d07",
                                "text": "Terwijl ik dagenlang alleen doorliep richting Canada vroeg ik me steeds vaker af wat er zou gebeuren als ik morgen dood zou gaan. Wat zou ik mijn kinderen dan nalaten?"
                            }
                        ]
                    },
                    {
                        "sense_id": "3afc329a-11a1-3e7c-bd94-c85ea657c3c8",
                        "entry_id": "83203dde-c32a-3850-bd06-e6f09e5d8fcf",
                        "glosses": [
                            "met elkaar vermengd raken"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dc1b7f77-56aa-433c-be9a-bfb64a1bdb21",
                                "sense_id": "3afc329a-11a1-3e7c-bd94-c85ea657c3c8",
                                "text": "Na het wassen op een te warme temperatuur waren de kleuren doorgelopen."
                            }
                        ]
                    }
                ],
