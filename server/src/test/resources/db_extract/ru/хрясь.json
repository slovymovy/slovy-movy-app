                                            {
                                                "example_id": "5aeeb3c2-955b-4e9d-8ac3-fd54cdbe6289",
                                                "sense_id": "d3fedec5-2cda-3dbe-8c28-7d22c1976b22",
                                                "text": "You know I still bang."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a80ff2ff-2e75-350f-ae94-31271199f60e",
                                        "entry_id": "18f368f2-d0f5-3367-87e2-423d2bf2cdfa",
                                        "glosses": [
                                            "Right, directly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "609eba62-4e43-4c09-9766-54685d8a4a93",
                                                "sense_id": "a80ff2ff-2e75-350f-ae94-31271199f60e",
                                                "text": "The passenger door was bang against the garage wall."
                                            },
                                            {
                                                "example_id": "a9e17bb7-2b18-46fc-81e0-40e95a7bc6c3",
                                                "sense_id": "a80ff2ff-2e75-350f-ae94-31271199f60e",
                                                "text": "After yet another missed penalty by Kvirikashvili from bang in front of the posts, England scored again, centre Tuilagi flying into the line and touching down under the bar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec7a92bf-45ba-348a-8ae1-ecd37e8d90d5",
                                        "entry_id": "18f368f2-d0f5-3367-87e2-423d2bf2cdfa",
                                        "glosses": [
                                            "Precisely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "991b9a5c-2cd3-448a-97af-41e2db9f363d",
                                                "sense_id": "ec7a92bf-45ba-348a-8ae1-ecd37e8d90d5",
                                                "text": "He arrived bang on time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57b2ba23-340a-34b7-b147-ca330f7ffb7c",
                                        "entry_id": "18f368f2-d0f5-3367-87e2-423d2bf2cdfa",
                                        "glosses": [
                                            "With a sudden impact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "141546b6-0972-4fe5-b9ec-a72ac874d5a6",
                                                "sense_id": "57b2ba23-340a-34b7-b147-ca330f7ffb7c",
                                                "text": "Distracted, he ran bang into the opening door."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "297ba53f-73d0-382e-91d0-4a00c209508c",
                                        "entry_id": "ec51fb93-e77b-36cb-9d01-01c0f7956265",
                                        "glosses": [
                                            "A sudden percussive sound, such as made by the firing of a gun, slamming of a door, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfced4bb-1948-4b0c-9504-a9be02e71802",
                                                "sense_id": "297ba53f-73d0-382e-91d0-4a00c209508c",
                                                "text": "He pointed his finger at her like a gun and said, “Bang!”"
                                            },
                                            {
                                                "example_id": "8cf461c0-33bc-4072-be7c-94d31a9c48ef",
                                                "sense_id": "297ba53f-73d0-382e-91d0-4a00c209508c",
                                                "text": "Bang! Away he goes with a mighty bound. Leo has missed him. Bang! right under him again. Now for a shot. I must have one, though he is going like an arrow, and a hundred yards away and more."
                                            },
                                            {
                                                "example_id": "06eb93cf-6099-4ff0-a236-4b992cd16469",
                                                "sense_id": "297ba53f-73d0-382e-91d0-4a00c209508c",
                                                "text": "“Just like parade it had been a minute before then stumble, bang, swish! Wiped out!” he said."
                                            },
                                            {
                                                "example_id": "3f0dedfd-cb71-427c-82ed-8143976fdc70",
                                                "sense_id": "297ba53f-73d0-382e-91d0-4a00c209508c",
                                                "text": "Serve him right. Transgression—punishment—bang! Pitiless, pitiless."
                                            },
                                            {
                                                "example_id": "5e5216c7-0b81-4ffd-ab03-6743b6cfbdc8",
                                                "sense_id": "297ba53f-73d0-382e-91d0-4a00c209508c",
                                                "text": "We help to kill the bloody bandits. Bang, bang, bang."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f029fc3b-a35b-330d-9e69-49245d6dcbca",
                                        "entry_id": "2fe84a02-800f-39b5-ab16-0ff840a45a9d",
                                        "glosses": [
                                            "Archaic form of bhang."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
