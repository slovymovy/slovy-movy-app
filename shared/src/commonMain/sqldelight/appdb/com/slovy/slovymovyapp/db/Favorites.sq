import com.slovy.slovymovyapp.data.learning.CardFamily;
import com.slovy.slovymovyapp.data.learning.CardKind;
import com.slovy.slovymovyapp.data.learning.CardState;
import com.slovy.slovymovyapp.data.learning.Rating;
import kotlin.Boolean;
import kotlin.uuid.Uuid;

CREATE TABLE favorites (
  sense_id TEXT NOT NULL,
  lang_code TEXT NOT NULL,
  lemma TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  activated_at INTEGER,
  PRIMARY KEY (sense_id, lang_code)
);

CREATE INDEX idx_favorites_pending_intake
ON favorites(activated_at, created_at);

CREATE INDEX idx_favorites_lang_lemma
ON favorites(lang_code, lemma);

CREATE TABLE card (
  id BLOB AS Uuid NOT NULL PRIMARY KEY,
  sense_id BLOB AS Uuid NOT NULL,
  lemma_id BLOB AS Uuid NOT NULL,
  lang_code TEXT NOT NULL,
  family INTEGER AS CardFamily NOT NULL,
  state INTEGER AS CardState NOT NULL,
  stability REAL NOT NULL,
  difficulty REAL NOT NULL,
  due INTEGER NOT NULL,
  last_review INTEGER,
  reps INTEGER NOT NULL DEFAULT 0,
  lapses INTEGER NOT NULL DEFAULT 0,
  created_at INTEGER NOT NULL,
  available_after INTEGER,
  answer_key TEXT NOT NULL,
  suspended INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX idx_card_unique_task
ON card(sense_id, lang_code, family);

CREATE INDEX idx_card_due_session
ON card(lang_code, suspended, due, created_at, available_after, state);

CREATE INDEX idx_card_new_session
ON card(lang_code, suspended, state, created_at, due, available_after);

CREATE INDEX idx_card_active_lemma_due
ON card(lang_code, suspended, lemma_id, due, available_after, sense_id);

CREATE INDEX idx_card_answer_siblings
ON card(lang_code, answer_key, suspended, family);

CREATE INDEX idx_card_active_created
ON card(lang_code, suspended, created_at);

CREATE TABLE review_log (
  id BLOB AS Uuid NOT NULL PRIMARY KEY,
  card_id BLOB AS Uuid NOT NULL,
  reviewed_at INTEGER NOT NULL,
  rating INTEGER AS Rating NOT NULL,
  variant_kind INTEGER AS CardKind NOT NULL,
  variant_target_lang TEXT,
  example_id INTEGER,
  state_before INTEGER AS CardState NOT NULL,
  stability_before REAL NOT NULL,
  difficulty_before REAL NOT NULL,
  elapsed_days INTEGER NOT NULL,
  scheduled_days INTEGER NOT NULL,
  stability_after REAL NOT NULL,
  difficulty_after REAL NOT NULL,
  duration_ms INTEGER NOT NULL
);

CREATE INDEX idx_review_log_card_reviewed
ON review_log(card_id, reviewed_at DESC);

CREATE INDEX idx_review_log_recent
ON review_log(reviewed_at DESC, card_id);

-- Favorite queries.
insertFavorite:
INSERT OR IGNORE INTO favorites(
  sense_id, lang_code, lemma, created_at, activated_at
) VALUES (?, ?, ?, ?, ?);

deleteFavorite:
DELETE FROM favorites WHERE sense_id = ? AND lang_code = ?;

selectAll:
SELECT sense_id, lang_code, lemma, created_at FROM favorites
ORDER BY created_at DESC;

selectAllFull:
SELECT sense_id, lang_code, lemma, created_at, activated_at
FROM favorites
ORDER BY created_at DESC;

selectByLangAndLemma:
SELECT sense_id, lang_code, lemma, created_at FROM favorites
WHERE lang_code = ? AND lemma = ?
ORDER BY created_at DESC;

selectAllOrderedByLangAndLemma:
SELECT sense_id, lang_code, lemma, created_at FROM favorites
ORDER BY (SELECT MAX(created_at) FROM favorites f2 WHERE f2.lemma = favorites.lemma) DESC, lang_code ASC, lemma ASC, created_at DESC;

selectByLemmaSearch:
SELECT sense_id, lang_code, lemma, created_at FROM favorites
WHERE lemma LIKE ?
ORDER BY (SELECT MAX(created_at) FROM favorites f2 WHERE f2.lemma = favorites.lemma) DESC, lang_code ASC, lemma ASC, created_at DESC;

countBySenseIdAndLang:
SELECT COUNT(*) FROM favorites WHERE sense_id = ? AND lang_code = ?;

selectFavoriteSummary:
SELECT sense_id, lang_code, lemma, created_at FROM favorites
WHERE sense_id = ? AND lang_code = ?;

selectFavoriteWithActivation:
SELECT sense_id, lang_code, lemma, created_at, activated_at
FROM favorites
WHERE sense_id = ? AND lang_code = ?;

selectDistinctLemmasByLang:
SELECT DISTINCT lemma FROM favorites WHERE lang_code = ?;

deleteAll:
DELETE FROM favorites;

selectPendingActivationLemmas:
SELECT
  f.lemma,
  COUNT(*) AS pending_count,
  EXISTS (
    SELECT 1 FROM favorites f2
    WHERE f2.lang_code = f.lang_code
      AND f2.lemma = f.lemma
      AND f2.activated_at IS NOT NULL
  ) AS is_extension
FROM favorites f
WHERE f.lang_code = :lang_code AND f.activated_at IS NULL
GROUP BY f.lemma
ORDER BY is_extension DESC, MIN(f.created_at) ASC
LIMIT :limit;

selectPendingActivationByLemma:
SELECT sense_id, lang_code, lemma, created_at, activated_at
FROM favorites
WHERE lang_code = ? AND lemma = ? AND activated_at IS NULL
ORDER BY created_at ASC;

countPendingFavoritesByLang:
SELECT COUNT(*)
FROM favorites
WHERE lang_code = :lang_code
  AND activated_at IS NULL;

countPendingFavoriteLemmasByLang:
SELECT COUNT(DISTINCT lemma)
FROM favorites
WHERE lang_code = :lang_code
  AND activated_at IS NULL;

selectPendingFavoriteLemmasByLang:
SELECT DISTINCT lemma
FROM favorites
WHERE lang_code = :lang_code
  AND activated_at IS NULL;

markFavoriteActivated:
UPDATE favorites
SET activated_at = ?
WHERE sense_id = ? AND lang_code = ?;

countFavorites:
SELECT COUNT(*) FROM favorites;

-- Card queries.
insertCard:
INSERT OR IGNORE INTO card(
  id, sense_id, lemma_id, lang_code, family, state, stability, difficulty,
  due, last_review, reps, lapses, created_at,
  available_after, answer_key, suspended
) VALUES (
  :id, :sense_id, :lemma_id, :lang_code, :family, :state, :stability, :difficulty,
  :due, :last_review, :reps, :lapses, :created_at,
  :available_after, :answer_key, :suspended
);

selectDueCards:
SELECT id, sense_id, lemma_id, lang_code, family, state,
       stability, difficulty, due, last_review, reps, lapses, created_at,
       available_after, answer_key, suspended
FROM card INDEXED BY idx_card_due_session
WHERE lang_code = :lang_code
  AND due <= :now
  AND state != :new_state
  AND family IN :allowed_families
  AND suspended = 0
  AND (available_after IS NULL OR available_after <= :now)
ORDER BY due ASC, created_at ASC
LIMIT :limit;

selectNewCards:
SELECT id, sense_id, lemma_id, lang_code, family, state,
       stability, difficulty, due, last_review, reps, lapses, created_at,
       available_after, answer_key, suspended
FROM card INDEXED BY idx_card_new_session
WHERE lang_code = :lang_code
  AND state = :new_state
  AND due <= :now
  AND family IN :allowed_families
  AND suspended = 0
  AND (available_after IS NULL OR available_after <= :now)
ORDER BY created_at ASC
LIMIT :limit;

selectCardById:
SELECT id, sense_id, lemma_id, lang_code, family, state,
       stability, difficulty, due, last_review, reps, lapses, created_at,
       available_after, answer_key, suspended
FROM card
WHERE id = :id;

selectCardBySenseAndFamily:
SELECT id, sense_id, lemma_id, lang_code, family, state,
       stability, difficulty, due, last_review, reps, lapses, created_at,
       available_after, answer_key, suspended
FROM card INDEXED BY idx_card_unique_task
WHERE sense_id = :sense_id
  AND lang_code = :lang_code
  AND family = :family;

selectCardsBySense:
SELECT id, sense_id, lemma_id, lang_code, family, state,
       stability, difficulty, due, last_review, reps, lapses, created_at,
       available_after, answer_key, suspended
FROM card INDEXED BY idx_card_unique_task
WHERE sense_id = :sense_id
  AND lang_code = :lang_code
  AND suspended = 0
ORDER BY family ASC;

selectCardsByFavorite:
SELECT id, sense_id, lemma_id, lang_code, family, state,
       stability, difficulty, due, last_review, reps, lapses, created_at,
       available_after, answer_key, suspended
FROM card INDEXED BY idx_card_unique_task
WHERE sense_id = :sense_id
  AND lang_code = :lang_code
ORDER BY family ASC;

-- Per-row jittered available_after target = :window_start + uniform[0, :window_width).
-- max() ensures we only push cards later, never pull them forward.
burySiblingCardsBySense:
UPDATE card INDEXED BY idx_card_unique_task
SET available_after = max(
    coalesce(available_after, 0),
    :window_start + ((random() % :window_width) + :window_width) % :window_width
)
WHERE sense_id = :sense_id
  AND lang_code = :lang_code
  AND id != :id
  AND suspended = 0;

burySiblingCardsByLemma:
UPDATE card INDEXED BY idx_card_active_lemma_due
SET available_after = max(
    coalesce(available_after, 0),
    :window_start + ((random() % :window_width) + :window_width) % :window_width
)
WHERE lang_code = :lang_code
  AND lemma_id = :lemma_id
  AND sense_id != :sense_id
  AND suspended = 0;

-- :allowed_families should be CardFamily entries with testsWordRecall = true.
burySiblingCardsByAnswer:
UPDATE card INDEXED BY idx_card_answer_siblings
SET available_after = max(
    coalesce(available_after, 0),
    :window_start + ((random() % :window_width) + :window_width) % :window_width
)
WHERE lang_code = :lang_code
  AND answer_key = :answer_key
  AND family IN :allowed_families
  AND id != :id
  AND suspended = 0;

countCardsByFavorite:
SELECT COUNT(*)
FROM card INDEXED BY idx_card_unique_task
WHERE sense_id = :sense_id
  AND lang_code = :lang_code;

selectActiveSenseIdsByLemma:
SELECT DISTINCT sense_id
FROM card INDEXED BY idx_card_active_lemma_due
WHERE lang_code = :lang_code
  AND lemma_id = :lemma_id
  AND suspended = 0;

countDueCardsByLang:
SELECT COUNT(*)
FROM card INDEXED BY idx_card_due_session
WHERE lang_code = :lang_code
  AND due <= :now
  AND suspended = 0
  AND (available_after IS NULL OR available_after <= :now);

countFutureScheduledCardsByLang:
SELECT COUNT(*)
FROM card INDEXED BY idx_card_due_session
WHERE lang_code = :lang_code
  AND due > :now
  AND suspended = 0;

countFutureScheduledLemmasByLang:
SELECT COUNT(DISTINCT lemma_id)
FROM card INDEXED BY idx_card_active_lemma_due
WHERE lang_code = :lang_code
  AND due > :now
  AND suspended = 0;

countDueCardsByLangDistinctByLemma:
SELECT COUNT(DISTINCT lemma_id)
FROM card INDEXED BY idx_card_active_lemma_due
WHERE lang_code = :lang_code
  AND due <= :now
  AND family IN :allowed_families
  AND suspended = 0
  AND (available_after IS NULL OR available_after <= :now);

countDelayedDueLemmasByLang:
SELECT COUNT(DISTINCT lemma_id)
FROM card INDEXED BY idx_card_active_lemma_due
WHERE lang_code = :lang_code
  AND due <= :now
  AND suspended = 0
  AND available_after IS NOT NULL
  AND available_after > :now;

countDelayedDueCardsByLang:
SELECT COUNT(*)
FROM card INDEXED BY idx_card_due_session
WHERE lang_code = :lang_code
  AND due <= :now
  AND suspended = 0
  AND available_after IS NOT NULL
  AND available_after > :now;

selectNextReviewAtByLang:
SELECT MIN(
  CASE
    WHEN available_after IS NOT NULL AND available_after > due THEN available_after
    ELSE due
  END
) AS next_review_at
FROM card INDEXED BY idx_card_due_session
WHERE lang_code = :lang_code
  AND suspended = 0;

countNewCardsCreatedSince:
SELECT COUNT(*)
FROM card INDEXED BY idx_card_active_created
WHERE lang_code = :lang_code
  AND created_at >= :since
  AND suspended = 0;

countCardsByLang:
SELECT COUNT(*)
FROM card INDEXED BY idx_card_active_created
WHERE lang_code = :lang_code
  AND suspended = 0;

countCardsByFamily:
SELECT family, COUNT(*) AS card_count
FROM card
WHERE suspended = 0
GROUP BY family
ORDER BY family ASC;

countMatureCardsByLang:
SELECT COUNT(*)
FROM card
WHERE lang_code = :lang_code
  AND stability >= :matureStability
  AND suspended = 0;

countDueToday:
SELECT COUNT(*)
FROM card
WHERE lang_code = :lang_code
  AND due <= :now
  AND suspended = 0;

updateCardAfterReview:
UPDATE card
SET state = :state,
    stability = :stability,
    difficulty = :difficulty,
    due = :due,
    last_review = :last_review,
    reps = :reps,
    lapses = :lapses
WHERE id = :id;

setCardAvailableAfter:
UPDATE card
SET available_after = :availableAfter
WHERE id = :id
  AND suspended = 0
  AND (available_after IS NULL OR available_after < :availableAfter);

-- Snapshot of every card touched by `setCardsAvailableAfterByLemma` so a paused word
-- can be undone via `restoreCardScheduling` per row. Includes suspended cards for the
-- same reason as the update below (see test `suspending_word_applies_delay_to_removed_meanings`).
selectCardScheduleByLemma:
SELECT id, suspended, available_after
FROM card INDEXED BY idx_card_active_lemma_due
WHERE lang_code = :lang_code
  AND suspended IN (0, 1)
  AND lemma_id = :lemma_id;

-- `suspended IN (0, 1)` is intentional: pausing a word should delay every card for the
-- lemma, including ones suspended by a removed meaning (see test
-- `suspending_word_applies_delay_to_removed_meanings`). It also acts as an explicit
-- skip-scan hint so the planner can use idx_card_active_lemma_due past the `suspended`
-- column to filter by `lemma_id`.
setCardsAvailableAfterByLemma:
UPDATE card INDEXED BY idx_card_active_lemma_due
SET available_after = :availableAfter
WHERE lang_code = :lang_code
  AND suspended IN (0, 1)
  AND lemma_id = :lemma_id
  AND (available_after IS NULL OR available_after < :availableAfter);

-- Propagated credit is not a direct review. Cards with no direct reps stay in
-- LEARNING even when propagated stability is review-grade.
creditSiblingCard:
UPDATE card
SET state = :state,
    stability = :stability,
    difficulty = CASE
        WHEN difficulty <= 0 THEN :difficulty
        ELSE difficulty
    END,
    due = max(due, :due)
WHERE id = :id
  AND suspended = 0
  AND stability < :stability;

clearAvailableAfterForDelayedLemmas:
UPDATE card
SET available_after = NULL
WHERE lang_code = :lang_code
  AND suspended = 0
  AND due <= :now
  AND available_after IS NOT NULL
  AND available_after > :now
  AND lemma_id IN (
    SELECT lemma_id
    FROM card
    WHERE lang_code = :lang_code
      AND suspended = 0
      AND due <= :now
      AND available_after IS NOT NULL
      AND available_after > :now
    GROUP BY lemma_id
    ORDER BY MIN(available_after) ASC, MIN(created_at) ASC
    LIMIT :lemma_limit
  );

suspendCardsByFavorite:
UPDATE card INDEXED BY idx_card_unique_task
SET suspended = 1
WHERE sense_id = :sense_id
  AND lang_code = :lang_code;

unsuspendCardsByFavorite:
UPDATE card INDEXED BY idx_card_unique_task
SET suspended = 0
WHERE sense_id = :sense_id
  AND lang_code = :lang_code;

-- Per-card restore used by undo to replay the exact `(suspended, available_after)`
-- captured in a snapshot taken before `remove()` ran. Non-destructive: nothing else
-- on the card row changes.
restoreCardScheduling:
UPDATE card
SET suspended = :suspended,
    available_after = :available_after
WHERE id = :id;

suspendAllCards:
UPDATE card
SET suspended = 1;

-- Review log queries.
insertReviewLog:
INSERT INTO review_log(
  id, card_id, reviewed_at, rating, variant_kind, variant_target_lang, example_id,
  state_before, stability_before, difficulty_before, elapsed_days, scheduled_days,
  stability_after, difficulty_after, duration_ms
) VALUES (
  :id, :card_id, :reviewed_at, :rating, :variant_kind, :variant_target_lang, :example_id,
  :state_before, :stability_before, :difficulty_before, :elapsed_days, :scheduled_days,
  :stability_after, :difficulty_after, :duration_ms
);

selectReviewLogsByCard:
SELECT reviewed_at, rating, variant_kind, variant_target_lang, example_id,
       state_before, stability_before, difficulty_before,
       elapsed_days, scheduled_days, stability_after, difficulty_after, duration_ms
FROM review_log INDEXED BY idx_review_log_card_reviewed
WHERE card_id = :card_id
ORDER BY reviewed_at DESC
LIMIT :limit;

selectLastReviewVariantByCard:
SELECT variant_kind, variant_target_lang
FROM review_log INDEXED BY idx_review_log_card_reviewed
WHERE card_id = :card_id
ORDER BY reviewed_at DESC
LIMIT 1;

selectReviewLogsBySense:
SELECT c.id AS card_id, c.family, r.reviewed_at, r.rating, r.variant_kind, r.variant_target_lang, r.duration_ms
FROM review_log r
JOIN card c ON c.id = r.card_id
WHERE c.sense_id = :sense_id
  AND c.lang_code = :lang_code
ORDER BY r.reviewed_at DESC;

selectRecentReviewedExampleIdsBySense:
SELECT r.example_id
FROM review_log r
JOIN card c ON c.id = r.card_id
WHERE c.sense_id = :sense_id AND r.example_id IS NOT NULL
ORDER BY r.reviewed_at DESC
LIMIT :limit;

selectRecentReviewedCards:
SELECT c.sense_id, c.lemma_id, c.answer_key, c.family, r.reviewed_at
FROM review_log r INDEXED BY idx_review_log_recent
JOIN card c ON c.id = r.card_id
WHERE c.lang_code = :lang_code
  AND r.reviewed_at >= :since
ORDER BY r.reviewed_at DESC
LIMIT :limit;

selectNextDueBySense:
SELECT MIN(
  CASE
    WHEN available_after IS NOT NULL AND available_after > due THEN available_after
    ELSE due
  END
) AS next_due
FROM card
WHERE sense_id = :sense_id
  AND lang_code = :lang_code
  AND suspended = 0;

selectLapsesBySense:
SELECT SUM(lapses) AS total_lapses
FROM card
WHERE sense_id = :sense_id
  AND lang_code = :lang_code;

countReviewsSince:
SELECT COUNT(*)
FROM review_log r INDEXED BY idx_review_log_recent
JOIN card c ON c.id = r.card_id
WHERE c.lang_code = :lang_code
  AND r.reviewed_at >= :since;

countReviewsBetween:
SELECT COUNT(*)
FROM review_log r INDEXED BY idx_review_log_recent
JOIN card c ON c.id = r.card_id
WHERE c.lang_code = :lang_code
  AND r.reviewed_at >= :start_inclusive
  AND r.reviewed_at < :end_exclusive;

selectReviewTimestampsSince:
SELECT r.reviewed_at
FROM review_log r INDEXED BY idx_review_log_recent
JOIN card c ON c.id = r.card_id
WHERE c.lang_code = :lang_code
  AND r.reviewed_at >= :since
ORDER BY r.reviewed_at ASC;

selectReviewTimestampsBetween:
SELECT r.reviewed_at
FROM review_log r INDEXED BY idx_review_log_recent
JOIN card c ON c.id = r.card_id
WHERE c.lang_code = :lang_code
  AND r.reviewed_at >= :start_inclusive
  AND r.reviewed_at < :end_exclusive;

selectCardSchedulingByLang:
SELECT sense_id, lemma_id, state, stability
FROM card
WHERE lang_code = :lang_code
  AND suspended = 0;

selectDeveloperCardTable:
SELECT
  f.lemma AS lemma,
  c.id AS id,
  c.sense_id AS sense_id,
  c.lemma_id AS lemma_id,
  c.lang_code AS lang_code,
  c.family AS family,
  c.state AS state,
  c.stability AS stability,
  c.difficulty AS difficulty,
  c.due AS due,
  c.last_review AS last_review,
  c.reps AS reps,
  c.lapses AS lapses,
  c.created_at AS created_at,
  c.available_after AS available_after,
  c.answer_key AS answer_key,
  c.suspended AS suspended
FROM card c
LEFT JOIN favorites f
  ON f.lang_code = c.lang_code
  AND f.sense_id = lower(
    substr(hex(c.sense_id), 1, 8) || '-' ||
    substr(hex(c.sense_id), 9, 4) || '-' ||
    substr(hex(c.sense_id), 13, 4) || '-' ||
    substr(hex(c.sense_id), 17, 4) || '-' ||
    substr(hex(c.sense_id), 21, 12)
  )
ORDER BY max(c.due, coalesce(c.available_after, c.due)) ASC, c.created_at ASC, c.id ASC
LIMIT :page_size OFFSET :page_offset;

countDeveloperCardTableRows:
SELECT COUNT(*)
FROM card;

countSuccessfulReviewsSince:
SELECT COUNT(*)
FROM review_log r INDEXED BY idx_review_log_recent
JOIN card c ON c.id = r.card_id
WHERE c.lang_code = :lang_code
  AND r.reviewed_at >= :since
  AND r.rating != 1;

countSuspendedCards:
SELECT COUNT(*)
FROM card
WHERE suspended = 1;

countAllCards:
SELECT COUNT(*)
FROM card;

deleteReviewLogsForSuspendedCards:
DELETE FROM review_log
WHERE card_id IN (
  SELECT id FROM card WHERE suspended = 1
);

deleteSuspendedCards:
DELETE FROM card
WHERE suspended = 1;

deleteAllLearning:
DELETE FROM review_log;

deleteAllCards:
DELETE FROM card;

resetFavoriteActivations:
UPDATE favorites SET activated_at = NULL;

-- Time-machine helper: shift every learning timestamp backwards by :shift_ms,
-- simulating that :shift_ms of wall-clock time has elapsed. For algorithm tuning only.
shiftFavoritesCreatedAtBack:
UPDATE favorites SET created_at = created_at - :shift_ms;

shiftFavoritesActivatedAtBack:
UPDATE favorites SET activated_at = activated_at - :shift_ms
WHERE activated_at IS NOT NULL;

shiftCardTimestampsBack:
UPDATE card
SET created_at      = created_at - :shift_ms,
    due             = due - :shift_ms,
    last_review     = CASE WHEN last_review     IS NULL THEN NULL ELSE last_review     - :shift_ms END,
    available_after = CASE WHEN available_after IS NULL THEN NULL ELSE available_after - :shift_ms END;

shiftReviewLogReviewedAtBack:
UPDATE review_log SET reviewed_at = reviewed_at - :shift_ms;
